{
    "name": "shykat199/webpbolt",
    "description": "Convert JPG, PNG, GIF and BMP images to WebP fast. Lightweight, zero dependencies, powered by PHP GD.",
    "type": "library",
    "keywords": [
        "webp",
        "image",
        "watermark",
        "converter",
        "image-conversion",
        "jpg-to-webp",
        "png-to-webp",
        "gd",
        "optimization",
        "compression",
        "laravel",
        "php"
    ],
    "homepage": "https://github.com/shykat199/webpbolt",
    "license": "MIT",
    "authors": [
        {
            "name": "Shykat",
            "email": "shykatroy.11815813@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-gd": "*"
    },
    "require-dev": {
        "pestphp/pest": "^2.34",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "suggest": {
        "ext-exif": "Needed by the AutoOrient transform to read rotation from phone photos",
        "illuminate/support": "Enables Laravel auto-discovery, config publishing and the images:webp command"
    },
    "autoload": {
        "psr-4": {
            "Shykat\\WebpBolt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shykat\\WebpBolt\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shykat\\WebpBolt\\Laravel\\WebpBoltServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}