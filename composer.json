    "license": "MIT",
    "authors": [
        {
            "name": "Shykat",
            "email": "shykatroy.11815813@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-gd": "*"
    },
    "autoload": {
        "psr-4": {
            "Shykat\\WebpBolt\\": "src/"
        }
